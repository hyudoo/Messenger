// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  createdAt      DateTime  @default(now())
  // when one of the user's sockets last disconnected ("active 5 minutes ago"; server/socket.ts)
  lastSeenAt     DateTime?
  // the user's own conversation settings (PATCH /api/conversations/[id]/settings). Private:
  // omitted from every query (app/libs/prismadb.ts) unless asked for
  mutedConversationIds  String[] @db.ObjectId
  pinnedConversationIds String[] @db.ObjectId
  // people this user blocked (POST /api/users/[userId]/block; app/libs/blocks.ts). Private too
  blockedUserIds        String[] @db.ObjectId
  updatedAt      DateTime  @updatedAt

  conversationIds String[]       @db.ObjectId
  conversations   Conversation[] @relation(fields: [conversationIds], references: [id])

  seenMessageIds String[]  @db.ObjectId
  seenMessages   Message[] @relation("Seen", fields: [seenMessageIds], references: [id])

  accounts          Account[]
  messages          Message[]
  reactions         Reaction[]
  pushSubscriptions WebPushSubscription[]
}

// A browser's Web Push subscription (app/libs/web-push.ts). One row per browser endpoint: signing
// in as someone else in the same browser moves it to that user.
model WebPushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  endpoint  String   @unique
  p256dh    String
  auth      String
  // the language the notifications are written in (the app's locale when subscribing)
  locale    String
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Conversation {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())
  name          String?
  isGroup       Boolean?
  // Groups only: the member who may delete the group for everyone (the creator; passed on to another
  // member when they leave). Missing on groups from before it existed: any member may delete those.
  ownerId       String?  @db.ObjectId

  messages Message[]

  userIds String[] @db.ObjectId
  users   User[]   @relation(fields: [userIds], references: [id])

  @@index([userIds, lastMessageAt])
}

model Message {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  body      String?
  isCall    Boolean?
  // Calls only: audio or video. Missing on calls from before audio calls existed = video.
  callType       CallType?
  // Calls only, kept by the socket server (server/call-log.ts): ringing -> answered -> ended, or
  // ringing -> declined / missed. Duration = callEndedAt - callAnsweredAt. Missing on older calls.
  callStatus     CallStatus?
  callAnsweredAt DateTime?
  callEndedAt    DateTime?
  image     String?
  // a file or a voice message (uploaded like images; app/libs/upload.ts has the allowed types)
  attachment MessageAttachment?
  // a copy of another message (POST /api/messages/[messageId]/forward), shown "Forwarded"
  forwarded Boolean?
  // group members named as "@Name" in the body (app/libs/mentions.ts), as they were then
  mentions MessageMention[]
  // the body without case or Vietnamese diacritics (searchTextOf), what search matches against;
  // older messages get it from scripts/backfill-search-text.ts
  searchText String?
  createdAt DateTime @default(now())
  // set when the sender edits the body (PATCH /api/messages/[messageId])
  editedAt  DateTime?
  // set when the sender recalls the message (DELETE /api/messages/[messageId]): body, image and
  // reactions are removed, the row stays so the chat shows "message recalled" in its place
  deletedAt DateTime?

  // A group event (app/libs/system-message.ts), shown as a centered line instead of a bubble; the
  // sender is who did it. systemName: the group's name (created / renamed). systemUsers: who was
  // added / removed, as they were then (a later rename or deleted account doesn't change it).
  systemType  SystemType?
  systemName  String?
  systemUsers SystemUser[]

  // the message this one replies to (same conversation). NoAction: required by MongoDB for a
  // self-relation; the original is never hard-deleted on its own (recall keeps the row, and a
  // conversation delete removes both)
  replyToId String?   @db.ObjectId
  replyTo   Message?  @relation("Replies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Message[] @relation("Replies")

  seenIds String[] @db.ObjectId
  seen    User[]   @relation("Seen", fields: [seenIds], references: [id])

  reactions Reaction[]

  conversationId String       @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String @db.ObjectId
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// An emoji reaction to a message (POST /api/messages/[messageId]/reactions). One per user per
// message: the same emoji again removes it, another one replaces it. Deleted with the message
// (or the user) through the cascade.
model Reaction {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  emoji     String
  createdAt DateTime @default(now())

  messageId String  @db.ObjectId
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

enum SystemType {
  created
  renamed
  added
  removed
  left
}

enum AttachmentKind {
  file
  voice
}

type MessageAttachment {
  kind     AttachmentKind
  url      String
  // the file's name as the sender had it (voice: generated)
  name     String
  size     Int
  // content type, without parameters
  type     String
  // voice only: length in ms
  duration Int?
}

type MessageMention {
  id    String  @db.ObjectId
  name  String
  email String?
}

type SystemUser {
  id    String  @db.ObjectId
  name  String?
  email String?
}

enum CallType {
  audio
  video
}

enum CallStatus {
  ringing
  answered
  declined
  missed
  ended
}
