DATABASE_URL=
NEXTAUTH_SECRET=
# Public URL of the app in production (OAuth callbacks, password reset links), e.g. https://chat.example.com
NEXTAUTH_URL=
# Port server.ts listens on (default 3000); docker-compose maps the same port on the host
PORT=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional public base URL for uploaded files (e.g. CloudFront). Defaults to https://<bucket>.s3.<region>.amazonaws.com
NEXT_PUBLIC_S3_PUBLIC_URL=

GITHUB_ID=
GITHUB_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NODE_ENV=
# "true" only behind a proxy that overwrites X-Real-IP (nginx: proxy_set_header X-Real-IP $remote_addr;)
TRUST_PROXY=

# Optional: share socket.io rooms and rate-limit counters between several instances.
# Either a full URL (wins when set; rediss:// for TLS) ...
REDIS_URL=
# ... or host / port / password. `docker compose up -d redis` starts this project's own Redis on
# 127.0.0.1:REDIS_PORT with REDIS_PASSWORD (6381 keeps clear of the portfolio's Redis on 6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_PASSWORD=
# Optional with REDIS_HOST: an ACL user of its own (Redis 6+), and the password from a file instead
# of the variable (Docker / Kubernetes secrets, e.g. /run/secrets/redis_password; REDIS_PASSWORD wins)
REDIS_USERNAME=
REDIS_PASSWORD_FILE=

# Optional TURN for video calls (coturn with use-auth-secret / static-auth-secret)
# e.g. TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
TURN_SECRET=
# credential lifetime in seconds (default 43200 = 12h)
TURN_TTL_SECONDS=

# Optional GIFs and stickers from GIPHY (https://developers.giphy.com, an API key of an app). Without
# it the composer has no "GIF" button. Read at run time; stays on the server.
GIPHY_API_KEY=

# Optional Web Push (message notifications with the tab closed): `npx web-push generate-vapid-keys`.
# Keep the pair: a new pair makes every browser subscribe again. Subject: mailto: or https URL
# (defaults to NEXTAUTH_URL when it is https)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional: "forgot password" mails over SMTP (app/libs/mailer.ts): Amazon SES SMTP credentials,
# Gmail with an app password, Resend, Mailgun... SMTP_SECURE=true for port 465 (TLS from the start),
# false for 587 (STARTTLS). SMTP_FROM is the sender, e.g. Messenger <no-reply@example.com> (an
# address / domain verified at the provider). Without SMTP_HOST + SMTP_FROM, production answers 503
# to a reset request and development prints the link in the server's console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
