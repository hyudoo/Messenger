DATABASE_URL=
NEXTAUTH_SECRET=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional public base URL for uploaded files (e.g. CloudFront). Defaults to https://<bucket>.s3.<region>.amazonaws.com
NEXT_PUBLIC_S3_PUBLIC_URL=

GITHUB_ID=
GITHUB_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NODE_ENV=
# "true" only behind a proxy that overwrites X-Real-IP (nginx: proxy_set_header X-Real-IP $remote_addr;)
TRUST_PROXY=

# Optional: share socket.io rooms and rate-limit counters between several instances
REDIS_URL=

# Optional TURN for video calls (coturn with use-auth-secret / static-auth-secret)
# e.g. TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
TURN_SECRET=
# credential lifetime in seconds (default 43200 = 12h)
TURN_TTL_SECONDS=
