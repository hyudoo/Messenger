DATABASE_URL=
NEXTAUTH_SECRET=
# Public URL of the app in production (OAuth callbacks), e.g. https://chat.example.com
NEXTAUTH_URL=
# Port server.ts listens on (default 3000); docker-compose maps the same port on the host
PORT=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional public base URL for uploaded files (e.g. CloudFront). Defaults to https://<bucket>.s3.<region>.amazonaws.com
NEXT_PUBLIC_S3_PUBLIC_URL=

GITHUB_ID=
GITHUB_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NODE_ENV=
# "true" only behind a proxy that overwrites X-Real-IP (nginx: proxy_set_header X-Real-IP $remote_addr;)
TRUST_PROXY=

# Optional: share socket.io rooms and rate-limit counters between several instances.
# Either a full URL (wins when set; rediss:// for TLS) ...
REDIS_URL=
# ... or host / port / password. `docker compose up -d redis` starts this project's own Redis on
# 127.0.0.1:REDIS_PORT with REDIS_PASSWORD (6381 keeps clear of the portfolio's Redis on 6379)
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_PASSWORD=

# Optional TURN for video calls (coturn with use-auth-secret / static-auth-secret)
# e.g. TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
TURN_SECRET=
# credential lifetime in seconds (default 43200 = 12h)
TURN_TTL_SECONDS=

# Optional Web Push (message notifications with the tab closed): `npx web-push generate-vapid-keys`.
# Keep the pair: a new pair makes every browser subscribe again. Subject: mailto: or https URL
# (defaults to NEXTAUTH_URL when it is https)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
